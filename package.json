{
  "name": "bambu-monitor",
  "version": "1.0.0",
  "description": "Web interface for monitoring Bambu Lab printers",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:client -- --host\" \"npm run dev:server\"",
    "dev:client": "vite",
    "dev:server": "nodemon src/server.js",
    "build": "vite build",
    "start": "node src/server.js",
    "deploy": "npm run build && npm start",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wayne927/bambu-monitor.git"
  },
