  "bugs": {
    "url": "https://github.com/wayne927/bambu-monitor/issues"
  },
  "homepage": "https://github.com/wayne927/bambu-monitor#readme",
  "dependencies": {
    "express": "^5.2.1",
    "mqtt": "^5.15.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "nodemon": "^3.1.14",
    "vite": "^8.3.1"
  }
